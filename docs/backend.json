
{
  "entities": {
    "VisitorPass": {
      "title": "VisitorPass",
      "type": "object",
      "description": "Represents a visitor pass for the AyushConclave- Arogya Expo.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the visitor."
        },
        "number": {
          "type": "string",
          "description": "The phone number of the visitor."
        },
        "mailId": {
          "type": "string",
          "description": "The email address of the visitor.",
          "format": "email"
        },
        "location": {
          "type": "string",
          "description": "The location of the visitor."
        },
        "gender": {
          "type": "string",
          "enum": [
            "Male",
            "Female",
            "Other"
          ],
          "description": "The gender of the visitor."
        },
        "registrationDate": {
          "type": "string",
          "description": "The date and time the visitor pass was registered.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "number",
        "mailId",
        "location",
        "gender",
        "registrationDate"
      ]
    },
    "AdminRole": {
      "title": "Admin Role",
      "type": "object",
      "description": "Defines an admin user's role. The existence of this document for a user's UID grants them admin privileges.",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "admin"
          ],
          "description": "The role of the user, which is always 'admin'."
        }
      },
      "required": [
        "role"
      ]
    },
    "CorporateWellnessRegistration": {
      "title": "Corporate Wellness Registration",
      "type": "object",
      "description": "Represents a registration for the Corporate Wellness Program.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the participant."
        },
        "age": {
          "type": "number",
          "description": "The age of the participant."
        },
        "gender": {
          "type": "string",
          "enum": [
            "Male",
            "Female",
            "Other"
          ],
          "description": "The gender of the participant."
        },
        "locality": {
          "type": "string",
          "description": "The locality of the participant."
        },
        "whatsappNumber": {
          "type": "string",
          "description": "The WhatsApp number of the participant."
        },
        "mailId": {
          "type": "string",
          "description": "The email address of the participant.",
          "format": "email"
        },
        "registrationDate": {
          "type": "string",
          "description": "The date and time the registration was submitted.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "age",
        "gender",
        "locality",
        "whatsappNumber",
        "mailId",
        "registrationDate"
      ]
    },
    "Job": {
      "title": "Job Posting",
      "type": "object",
      "description": "Represents a job opening in the portal.",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["Full-time", "Part-time", "Contract", "Internship"] },
        "description": { "type": "string" },
        "logoUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "requirements": { "type": "string" },
        "salary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "company", "description", "createdAt"]
    },
    "JobSeekerProfile": {
      "title": "Job Seeker Profile",
      "type": "object",
      "description": "Complete details of a candidate.",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "skills": { "type": "string" },
        "experience": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "age", "gender", "phone", "whatsappNumber", "resumeUrl", "skills", "experience"]
    },
    "JobApplication": {
      "title": "Job Application",
      "type": "object",
      "description": "A candidate's application for a specific job.",
      "properties": {
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "userId": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "skills": { "type": "string" },
        "experience": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Reviewed", "Shortlisted", "Rejected"] },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "userId", "applicantName", "appliedAt"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "collection_groups": [],
    "structure": [
      {
        "path": "/visitor_passes/{visitorPassId}",
        "definition": {
          "entityName": "VisitorPass",
          "schema": { "$ref": "#/backend/entities/VisitorPass" },
          "description": "Stores visitor pass information."
        }
      },
      {
        "path": "/admin_roles/{uid}",
        "definition": {
          "entityName": "AdminRole",
          "schema": { "$ref": "#/backend/entities/AdminRole" },
          "description": "Admin status documents."
        }
      },
      {
        "path": "/wellness_registrations/{registrationId}",
        "definition": {
          "entityName": "CorporateWellnessRegistration",
          "schema": { "$ref": "#/backend/entities/CorporateWellnessRegistration" },
          "description": "Wellness program registrations."
        }
      },
      {
        "path": "/jobs/{jobId}",
        "definition": {
          "entityName": "Job",
          "schema": { "$ref": "#/backend/entities/Job" },
          "description": "Public job postings."
        }
      },
      {
        "path": "/seeker_profiles/{userId}",
        "definition": {
          "entityName": "JobSeekerProfile",
          "schema": { "$ref": "#/backend/entities/JobSeekerProfile" },
          "description": "User profile data."
        }
      },
      {
        "path": "/job_applications/{applicationId}",
        "definition": {
          "entityName": "JobApplication",
          "schema": { "$ref": "#/backend/entities/JobApplication" },
          "description": "Applications submitted for jobs."
        }
      }
    ]
  }
}
