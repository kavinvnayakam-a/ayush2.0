rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow guest users (unauthenticated) to create documents in the 'visitors' collection for the free pass.
    // For security, this rule only allows creation. Reading, updating, and deleting are denied.
    match /visitors/{visitorId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
