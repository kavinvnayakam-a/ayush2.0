rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    match /visitor_passes/{visitorPassId} {
      allow create: if true; // Anyone can create a visitor pass
      allow read: if isAdmin();
      // list is implicitly denied for non-admins now
      // update and delete are implicitly denied
    }

    match /admin_roles/{uid} {
      allow read: if request.auth.uid == uid && isAdmin();
      // create, update, delete, and list are implicitly denied.
    }
  }
}
