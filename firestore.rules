rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    match /visitor_passes/{visitorPassId} {
      // Allow anyone to create a visitor pass.
      allow create: if true;
      
      // Only admins can read, list, update, or delete passes.
      allow read, update, delete: if isAdmin();
    }

    match /admin_roles/{uid} {
      allow read: if request.auth.uid == uid && isAdmin();
    }
  }
}
