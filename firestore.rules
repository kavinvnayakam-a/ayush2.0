rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      let adminEmails = ['kavinvnayakam@gmail.com', 'mainadmin@shreevarma.org'];
      return request.auth != null && (request.auth.token.email in adminEmails || 
             exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid)));
    }

    match /visitor_passes/{visitorPassId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /admin_roles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    match /wellness_registrations/{registrationId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /mail/{docId} {
      allow create: if true;
      allow read, update, delete, list: if false;
    }

    // Job Portal Rules - Ensure public read access for job listings
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seeker_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    match /job_applications/{applicationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow list, update: if isAdmin();
    }
  }
}
