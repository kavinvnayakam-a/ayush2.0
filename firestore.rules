rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Grant admin access if the user's email is kavinvnayakam@gmail.com
      // OR if they have a document in the admin_roles collection.
      return request.auth.token.email == 'kavinvnayakam@gmail.com' || 
             exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    match /visitor_passes/{visitorPassId} {
      // Allow anyone to create a visitor pass.
      allow create: if true;
      
      // Only admins can read, list, update, or delete passes.
      allow read, update, delete: if isAdmin();
    }
    
    match /visitor_passes/{document=**} {
        allow list: if isAdmin();
    }

    match /admin_roles/{uid} {
      allow read: if request.auth.uid == uid && isAdmin();
    }
  }
}
