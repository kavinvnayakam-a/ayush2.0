rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Grant admin access if the user's email is one of the designated admin emails
      // OR if they have a document in the admin_roles collection.
      let adminEmails = ['kavinvnayakam@gmail.com', 'mainadmin@shreevarma.org'];
      return request.auth.token.email in adminEmails || 
             exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    match /visitor_passes/{visitorPassId} {
      // Allow anyone to create a visitor pass.
      allow create: if true;
      
      // Only admins can read, list, update, or delete passes.
      allow read, update, delete: if isAdmin();
    }
    
    match /visitor_passes/{document=**} {
        allow list: if isAdmin();
    }

    match /admin_roles/{uid} {
      // Allow an authenticated user to read their own admin role document.
      // This is safe and necessary for the dashboard to verify admin status.
      allow get: if request.auth.uid == uid;
    }
  }
}
